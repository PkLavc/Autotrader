[Unit]
Description=AudaceFi historical research and verified GitHub publication (no trades)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=1h
StartLimitBurst=3

[Service]
Type=oneshot
User=autotrader
Group=autotrader
WorkingDirectory=/opt/autotrader
Environment=PYTHONPATH=/opt/autotrader
Environment=AUDACEFI_ALLOWLIST_SNAPSHOT=/opt/autotrader/deploy/oracle/audacefi-s1-allowlist.snapshot.json
Environment=AUDACEFI_HISTORY_REPORT=/var/lib/autotrader/audacefi/audacefi-historical-qualification.json
Environment=AUDACEFI_HISTORY_CACHE_DIR=/var/lib/autotrader/audacefi/history-cache
Environment=AUDACEFI_HISTORY_RESULT_CACHE=/var/lib/autotrader/audacefi/evaluations
Environment=AUDACEFI_STATE_DIR=/var/lib/autotrader/audacefi
ExecStart=/usr/bin/flock -w 3600 /var/lib/autotrader/audacefi/service.lock /usr/bin/bash /opt/autotrader/deploy/oracle/audacefi-research-run.sh
StateDirectory=autotrader/audacefi
StateDirectoryMode=0700
UMask=0077
Nice=10
CPUQuota=35%
MemoryHigh=1200M
MemoryMax=1536M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/autotrader /var/lib/autotrader/audacefi
TimeoutStartSec=5400
Restart=on-failure
RestartSec=120s
